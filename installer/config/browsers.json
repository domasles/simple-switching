{
  "extension_id": "todo",
  "default_shortcut": "Ctrl+Tab",
  "browsers": {
    "chrome": {
      "display_name": "Google Chrome",
      "windows": {
        "base_path": "%LOCALAPPDATA%/Google/Chrome/User Data",
        "executables": ["chrome.exe"],
        "policy_key": "Google\\Chrome"
      },
      "macos": {
        "base_path": "~/Library/Application Support/Google/Chrome",
        "executables": ["Google Chrome"],
        "policy_bundle": "com.google.Chrome"
      },
      "linux": {
        "base_path": "~/.config/google-chrome",
        "executables": ["google-chrome", "google-chrome-stable", "chrome"],
        "policy_dir": "/etc/opt/chrome/policies/managed"
      }
    },
    "chrome_canary": {
      "display_name": "Google Chrome Canary",
      "windows": {
        "base_path": "%LOCALAPPDATA%/Google/Chrome SxS/User Data",
        "executables": ["chrome.exe"],
        "policy_key": "Google\\Chrome SxS"
      },
      "macos": {
        "base_path": "~/Library/Application Support/Google/Chrome Canary",
        "executables": ["Google Chrome Canary"],
        "policy_bundle": "com.google.Chrome.canary"
      },
      "linux": {
        "base_path": "~/.config/google-chrome-canary",
        "executables": ["google-chrome-unstable", "google-chrome-canary"],
        "policy_dir": "/etc/opt/chrome/policies/managed"
      }
    },
    "chromium": {
      "display_name": "Chromium",
      "windows": {
        "base_path": "%LOCALAPPDATA%/Chromium/User Data",
        "executables": ["chrome.exe"],
        "policy_key": "Chromium"
      },
      "macos": {
        "base_path": "~/Library/Application Support/Chromium",
        "executables": ["Chromium"],
        "policy_bundle": "org.chromium.Chromium"
      },
      "linux": {
        "base_path": "~/.config/chromium",
        "executables": ["chromium", "chromium-browser"],
        "policy_dir": "/etc/chromium/policies/managed"
      }
    },
    "edge": {
      "display_name": "Microsoft Edge",
      "windows": {
        "base_path": "%LOCALAPPDATA%/Microsoft/Edge/User Data",
        "executables": ["msedge.exe"],
        "policy_key": "Microsoft\\Edge"
      },
      "macos": {
        "base_path": "~/Library/Application Support/Microsoft Edge",
        "executables": ["Microsoft Edge"],
        "policy_bundle": "com.microsoft.Edge"
      },
      "linux": {
        "base_path": "~/.config/microsoft-edge",
        "executables": ["microsoft-edge", "microsoft-edge-stable"],
        "policy_dir": "/etc/opt/edge/policies/managed"
      }
    },
    "brave": {
      "display_name": "Brave Browser",
      "windows": {
        "base_path": "%LOCALAPPDATA%/BraveSoftware/Brave-Browser/User Data",
        "executables": ["brave.exe"],
        "policy_key": "BraveSoftware\\Brave-Browser"
      },
      "macos": {
        "base_path": "~/Library/Application Support/BraveSoftware/Brave-Browser",
        "executables": ["Brave Browser"],
        "policy_bundle": "com.brave.Browser"
      },
      "linux": {
        "base_path": "~/.config/BraveSoftware/Brave-Browser",
        "executables": ["brave-browser", "brave", "brave-browser-stable"],
        "policy_dir": "/etc/brave/policies/managed"
      }
    },
    "vivaldi": {
      "display_name": "Vivaldi",
      "windows": {
        "base_path": "%LOCALAPPDATA%/Vivaldi/User Data",
        "executables": ["vivaldi.exe"],
        "policy_key": "Vivaldi"
      },
      "macos": {
        "base_path": "~/Library/Application Support/Vivaldi",
        "executables": ["Vivaldi"],
        "policy_bundle": "com.vivaldi.Vivaldi"
      },
      "linux": {
        "base_path": "~/.config/vivaldi",
        "executables": ["vivaldi", "vivaldi-bin", "vivaldi-stable"],
        "policy_dir": "/etc/vivaldi/policies/managed"
      }
    }
  },
  "shortcut": {
    "windows": "win:Ctrl+Tab",
    "macos": "mac:Ctrl+Tab",
    "linux": "linux:Ctrl+Tab"
  }
}
